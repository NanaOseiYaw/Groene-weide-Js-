# Copy this file to ".env" and change what you need. Never commit ".env".
# Every value below has a safe default for local development, so ".env" is optional.

# ---------- Server ----------
# development | production | test
NODE_ENV=development
PORT=3000

# ---------- Database ----------
# Path of the SQLite file, relative to the server folder.
DATABASE_PATH=data/groeneweide.db

# Fill the database with dummy data on start when it is empty (development only).
SEED_ON_START=true

# ---------- Campsite (shown in the header, footer and e-mails) ----------
# The phone number and e-mail below are PLACEHOLDERS. Replace them with Bert's real details.
CAMPSITE_NAME=Camping De Groene Weide
CAMPSITE_PHONE=012 345 67 89
CAMPSITE_EMAIL=info@groeneweide.example

# Time zone that decides what "today" is (season, past dates, daily overview).
TIME_ZONE=Europe/Amsterdam

# ---------- E-mail and payment (simulated in the MVP) ----------
# E-mails to guests are not sent: they are written to this folder (mail.log), relative to the server folder.
MAIL_FOLDER=data/mail
# The test payment always succeeds after this many milliseconds. No money changes hands.
PAYMENT_DELAY_MS=1500

# ---------- Later phases (not used yet) ----------
# Python AI service (Mohammed). The core app keeps working when it is down.
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_KEY=change-me
# AI_TIMEOUT_MS=5000
