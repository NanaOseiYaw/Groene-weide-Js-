# Copy this file to ".env" and change what you need. Never commit ".env".
# Every value below has a safe default for local development, so ".env" is optional.

# ---------- Server ----------
# development | production | test
NODE_ENV=development
PORT=3000

# ---------- Database ----------
# Path of the SQLite file, relative to the server folder.
DATABASE_PATH=data/groeneweide.db

# Fill the database with dummy data on start when it is empty (development only).
SEED_ON_START=true

# ---------- Campsite (shown in the header, footer and e-mails) ----------
# The phone number and e-mail below are PLACEHOLDERS. Replace them with Bert's real details.
CAMPSITE_NAME=Camping De Groene Weide
CAMPSITE_PHONE=012 345 67 89
CAMPSITE_EMAIL=info@groeneweide.example

# Time zone that decides what "today" is (season, past dates, daily overview).
TIME_ZONE=Europe/Amsterdam

# ---------- E-mail and payment (simulated in the MVP) ----------
# E-mails to guests are not sent: they are written to this folder (mail.log), relative to the server folder.
MAIL_FOLDER=data/mail
# The test payment always succeeds after this many milliseconds. No money changes hands.
PAYMENT_DELAY_MS=1500

# ---------- Photos and security ----------
# Uploaded spot photos, relative to the server folder (not in git).
UPLOADS_FOLDER=data/uploads
# Only needed when the frontend runs on a different address than the API (comma separated).
# Requests that change something from any other website are refused.
# The Vite dev server (http://localhost:5173) is allowed automatically, in development only.
ALLOWED_ORIGINS=

# Rate limits per visitor (IP address). 0 switches a limit off.
# Sign-in attempts per 15 minutes, and new reservations per hour.
RATE_LIMIT_LOGIN=20
RATE_LIMIT_RESERVATIONS=30

# ---------- AI service (Python, by Mohammed) ----------
# See docs/ai-contract.md. Leave AI_SERVICE_URL empty to switch AI off: the rest of the site
# works the same, AI features answer "niet beschikbaar". Without Python: run "npm run ai:mock"
# and set AI_SERVICE_URL=http://localhost:8000.
AI_SERVICE_URL=
# Shared secret, sent as X-Service-Key. Required in production (at least 16 characters).
# Never commit a real key; make one with: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
AI_SERVICE_KEY=
# How long the API waits for one AI answer, in milliseconds (100–60000).
AI_TIMEOUT_MS=5000
# Port of the fake AI service (npm run ai:mock).
AI_MOCK_PORT=8000
