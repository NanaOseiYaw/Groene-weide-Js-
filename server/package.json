{
  "name": "@groene-weide/server",
  "version": "0.1.0",
  "private": true,
  "description": "JSON API for Camping De Groene Weide (Express + SQLite).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "create-staff": "node scripts/create-staff.js",
    "ai:mock": "node scripts/ai-mock.js"
  },
  "dependencies": {
    "@groene-weide/shared": "0.1.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
