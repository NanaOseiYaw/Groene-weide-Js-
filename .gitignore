# Dependencies
node_modules/

# Build output (the Vue client builds to client/dist)
dist/
coverage/

# Environment files: never commit real settings or secrets.
# .env.example is the template and IS committed.
.env
.env.*
!.env.example

# Runtime data: SQLite database, mail log, uploaded photos (server/data)
server/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
npm-debug.log*
*.log

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Local Claude Code worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json
